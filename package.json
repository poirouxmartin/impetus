{
  "name": "glisse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "stats": "esbuild src/scripts/selfplay.ts --bundle --platform=node --format=cjs --outfile=dist/selfplay.cjs --log-level=warning && node dist/selfplay.cjs",
    "solve": "esbuild src/scripts/solve.ts --bundle --platform=node --format=cjs --outfile=dist/solve.cjs --log-level=warning && node --stack-size=100000 dist/solve.cjs",
    "duel": "esbuild src/scripts/duel.ts --bundle --platform=node --format=cjs --outfile=dist/duel.cjs --log-level=warning && node dist/duel.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
