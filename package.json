{
  "name": "impetus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "stats": "esbuild src/scripts/selfplay.ts --bundle --platform=node --format=cjs --outfile=dist/selfplay.cjs --log-level=warning && node dist/selfplay.cjs",
    "balance": "esbuild src/scripts/balance.ts --bundle --platform=node --format=cjs --outfile=dist/balance.cjs --log-level=warning && node dist/balance.cjs",
    "solve": "esbuild src/scripts/solve.ts --bundle --platform=node --format=cjs --outfile=dist/solve.cjs --log-level=warning && node --stack-size=100000 dist/solve.cjs",
    "duel": "esbuild src/scripts/duel.ts --bundle --platform=node --format=cjs --outfile=dist/duel.cjs --log-level=warning && node dist/duel.cjs",
    "server": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --log-level=warning && node dist-server/server.cjs",
    "wstest": "esbuild scripts/wstest.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/wstest.mjs --log-level=warning && node dist-server/wstest.mjs",
    "shots": "esbuild scripts/shot.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist-server/shot.mjs --log-level=warning && node dist-server/shot.mjs",
    "nn:gen": "esbuild src/scripts/gen-dataset.ts --bundle --platform=node --format=cjs --outfile=dist/gen-dataset.cjs --log-level=warning && node dist/gen-dataset.cjs",
    "nn:train": "esbuild src/scripts/train-nn.ts --bundle --platform=node --format=cjs --outfile=dist/train-nn.cjs --log-level=warning && node dist/train-nn.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
